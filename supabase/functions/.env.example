# Edge Functions — copy to `.env` in this directory.
# Git ignores `supabase/functions/.env`. Restart the stack after editing:
#   npm run supabase:stop && npm run supabase:start
#
# Get a key: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# #405 — Fallback Provider for in-app AI calls when Gemini is unavailable (503).
# No-card free tier: https://console.groq.com/keys . Absent = fallback disabled
# (the Primary's error surfaces unchanged); the app stays fully functional.
GROQ_API_KEY=

# send-transactional-email (Resend welcome mail) — set in Supabase Dashboard secrets for production
# RESEND_API_KEY=re_xxx
# WEBHOOK_SECRET=long-random-string-matching-database-webhook-header
# FROM_EMAIL=no-reply@gymlogic.me
# SKIP_EMAIL_DOMAINS=example.com
# Published Resend Template alias (or UUID). Default: welcome
# RESEND_WELCOME_TEMPLATE_ID=welcome
# Optional https overrides for Welcome Email variables (else gymlogic.me / docs.gymlogic.me)
# APP_URL=https://gymlogic.me
# TOUR_URL=https://docs.gymlogic.me/tour
# CONNECT_URL=https://docs.gymlogic.me/connect/claude
# Optional: separate secret for unsubscribe links (defaults to WEBHOOK_SECRET)
# UNSUBSCRIBE_SECRET=
