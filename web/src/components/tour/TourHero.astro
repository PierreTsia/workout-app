---
import { tourHero } from '@/lib/tourCopy'
---

<section aria-labelledby="tour-hero-h1" class="mx-auto max-w-3xl px-4 pt-12 md:pt-20">
  <h1
    id="tour-hero-h1"
    class="text-4xl md:text-5xl font-semibold tracking-tight text-foreground"
  >
    {tourHero.h1}
  </h1>
  <p class="mt-6 text-lg text-muted leading-relaxed">
    {tourHero.sub}
  </p>
  <p class="mt-4 hidden text-sm text-muted md:block">Scroll the tour →</p>
</section>
