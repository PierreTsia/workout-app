---
---

<button
  type="button"
  data-demo-trigger
  aria-label="Expand demo"
  class="group relative block w-full overflow-hidden rounded-xl border border-border bg-card focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-safe:transition-shadow motion-safe:duration-200 hover:shadow-2xl hover:shadow-accent/10"
>
  <video
    data-demo-inline
    muted
    loop
    playsinline
    preload="metadata"
    poster="/demo-poster.jpg"
    aria-hidden="true"
    class="block w-full"
  >
    <source src="/demo.webm" type="video/webm" />
    <source src="/demo.mp4" type="video/mp4" />
  </video>
  <span
    class="absolute right-3 top-3 inline-flex items-center gap-2 rounded-full bg-black/60 px-3 py-1.5 text-xs font-medium text-white backdrop-blur-sm motion-safe:transition-colors motion-safe:duration-150 group-hover:bg-black/80 group-focus-visible:bg-black/80"
  >
    <svg
      aria-hidden="true"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <polyline points="15 3 21 3 21 9"></polyline>
      <polyline points="9 21 3 21 3 15"></polyline>
      <line x1="21" y1="3" x2="14" y2="10"></line>
      <line x1="3" y1="21" x2="10" y2="14"></line>
    </svg>
    <span>Expand</span>
  </span>
</button>

<dialog
  id="demo-dialog"
  aria-labelledby="demo-dialog-title"
  class="m-auto bg-card border border-border rounded-lg p-0 max-w-5xl w-[calc(100vw-2rem)] shadow-2xl text-foreground [&::backdrop]:bg-black/80 [&::backdrop]:backdrop-blur-sm"
>
  <h2 id="demo-dialog-title" class="sr-only">Demo</h2>
  <div class="relative">
    <button
      type="button"
      data-demo-close
      aria-label="Close demo"
      class="absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-foreground/10 text-foreground hover:bg-foreground/20 motion-safe:transition-colors motion-safe:duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      <span aria-hidden="true" class="text-xl leading-none">×</span>
    </button>
    <video
      data-demo-cinema
      controls
      preload="none"
      poster="/demo-poster.jpg"
      playsinline
      class="w-full rounded-t-lg bg-black"
    >
      <source src="/demo.webm" type="video/webm" />
      <source src="/demo.mp4" type="video/mp4" />
      <track
        default
        kind="captions"
        srclang="en"
        label="English"
        src="/demo.en.vtt"
      />
      Your browser doesn't support the video tag.
    </video>
    <p class="px-4 py-3 text-sm text-muted">
      Demo: Claude Desktop. Same flow works in Cursor, ChatGPT, or any MCP
      client.
    </p>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('demo-dialog') as
    | HTMLDialogElement
    | null
  const trigger = document.querySelector<HTMLElement>('[data-demo-trigger]')
  const closeBtn = dialog?.querySelector<HTMLButtonElement>(
    '[data-demo-close]',
  )
  const cinemaVideo = dialog?.querySelector<HTMLVideoElement>(
    '[data-demo-cinema]',
  )
  const inlineVideo = document.querySelector<HTMLVideoElement>(
    '[data-demo-inline]',
  )

  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches

  if (inlineVideo && !reducedMotion) {
    void inlineVideo.play().catch(() => {
      // Autoplay may be blocked by browser policy; the poster is shown until interaction.
    })
  }

  if (dialog && trigger && cinemaVideo) {
    trigger.addEventListener('click', (e) => {
      e.preventDefault()
      inlineVideo?.pause()
      dialog.showModal()
      void cinemaVideo.play().catch(() => {
        // User can press play manually.
      })
    })

    closeBtn?.addEventListener('click', () => {
      dialog.close()
    })

    dialog.addEventListener('close', () => {
      cinemaVideo.pause()
      cinemaVideo.currentTime = 0
      if (inlineVideo && !reducedMotion) {
        void inlineVideo.play().catch(() => {})
      }
    })

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close()
    })
  }
</script>
