---
interface Segment {
  label: string
  meta: string
  width: number
  kind?: 'phase' | 'rest'
}

interface Mark {
  pct: number
  label: string
  tone?: 'neutral' | 'pass' | 'fail'
  level?: 1 | 2
}

interface Props {
  segments: Segment[]
  marks: Mark[]
  note?: string
}

const { segments, marks, note } = Astro.props

const fill = {
  neutral: '#8a8a93',
  pass: '#00c9a7',
  fail: '#ef4444',
}

let acc = 0
const spans = segments.map((segment) => {
  const left = acc
  acc += segment.width
  return { ...segment, left }
})

// A label near either end is pulled inward so it does not hang off the bar.
const anchor = (pct: number) =>
  pct < 12 ? 'translateX(-20%)' : pct > 94 ? 'translateX(-80%)' : 'translateX(-50%)'
---

<div class="not-prose my-8 rounded-lg border border-border bg-card px-5 pt-20 pb-6">
  <div class="px-6">
    <div class="relative h-1.5">
      {
        spans.map((segment) => (
          <span
            class="absolute top-0 h-1.5"
            style={`left:${segment.left}%; width:${segment.width}%; border-radius:0.375rem; background:${
              segment.kind === 'rest'
                ? 'repeating-linear-gradient(90deg, #2d2d37 0 5px, transparent 5px 10px)'
                : '#2d2d37'
            }`}
          />
        ))
      }

      {
        marks.map((mark) => (
          <>
            <span
              class="absolute h-3 w-3 rounded-full"
              style={`left:${mark.pct}%; top:-0.19rem; transform:translateX(-50%); background:${fill[mark.tone ?? 'neutral']}`}
            />
            <span
              class="absolute text-[11px] whitespace-nowrap text-muted"
              style={`left:${mark.pct}%; top:${mark.level === 2 ? '-3.4rem' : '-1.6rem'}; transform:${anchor(mark.pct)}`}
            >
              {mark.label}
            </span>
          </>
        ))
      }
    </div>

    <div class="mt-5 flex text-[11px] text-muted">
      {
        spans.map((segment) => (
          <div style={`width:${segment.width}%`}>
            <p class="font-mono text-foreground">{segment.label}</p>
            <p>{segment.meta}</p>
          </div>
        ))
      }
    </div>

    {note && <p class="mt-4 text-[11px] text-muted">{note}</p>}
  </div>
</div>
