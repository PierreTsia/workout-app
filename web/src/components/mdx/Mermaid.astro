---
// Renders ```mermaid fenced blocks in MDX as diagrams, client-side.
//
// Astro's shiki pass turns the fence into <pre data-language="mermaid">, which is
// what the loader looks for. The script is `is:inline` so Astro emits it verbatim
// instead of bundling it: the mermaid module comes from the CDN through a dynamic
// import, which a bundled script would try to resolve at build time.
//
// Draft-stage device: no dependency is added to the project. Moving this to a
// published post means either installing mermaid + a build-time renderer, or
// keeping the CDN import and accepting it in production.
---

<script type="module" is:inline>
  const blocks = document.querySelectorAll('pre[data-language="mermaid"]');

  if (blocks.length) {
    const holders = [...blocks].map((pre) => {
      const div = document.createElement('div');
      div.className = 'mermaid';
      div.textContent = pre.textContent;
      pre.replaceWith(div);
      return div;
    });

    const { default: mermaid } = await import(
      'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs'
    );

    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      securityLevel: 'loose',
      fontFamily: "'Geist Mono Variable', ui-monospace, monospace",
      themeVariables: {
        fontSize: '13px',
        background: 'transparent',
        primaryColor: '#1a1a22',
        primaryTextColor: '#f2f2f2',
        primaryBorderColor: '#2d2d37',
        secondaryColor: '#15151c',
        tertiaryColor: '#15151c',
        lineColor: '#8a8a93',
        edgeLabelBackground: '#0f0f13',
        clusterBkg: '#15151c',
        clusterBorder: '#2d2d37',
      },
      flowchart: { curve: 'basis', useMaxWidth: true, padding: 12 },
    });

    await mermaid.run({ nodes: holders });
  }
</script>
